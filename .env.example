# Copy this file to .env (git-ignored) and fill in real values.
# Every variable here is validated at startup by src/config.ts.

# development | test | production
NODE_ENV=development

# Port the HTTP + WebSocket server listens on
PORT=4000

# Datastores from docker-compose.yml (note the non-default host ports)
REDIS_URL=redis://localhost:6380
MONGO_URL=mongodb://localhost:27018/mymis_chat

# Must match mymis-api's Jwt:Key / Jwt:Issuer / Jwt:Audience exactly,
# otherwise every token from the API will be rejected.
# Key must be at least 32 characters (HS256 needs a 256-bit key, same rule as .NET).
JWT_KEY=replace-with-the-same-key-as-mymis-api-at-least-32-chars
JWT_ISSUER=replace-with-mymis-api-issuer
JWT_AUDIENCE=replace-with-mymis-api-audience

# Comma-separated browser origins allowed to open a WebSocket (the portal's Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173